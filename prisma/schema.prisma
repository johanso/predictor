// Prisma schema — cache layer for football-data.org standings.
// Not a historical archive: TeamStanding rows are overwritten on refresh.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// One of the owner's own bookmaker accounts — "Bet365", "Betano". It exists so
// bets and bankroll can be kept, and their yield measured, per bookmaker.
//
// Three things in this schema read like synonyms and are not:
//   Account            — the owner's bookmaker account (this model)
//   Bet.source         — where the *pick* came from ("modelo", a tipster's name)
//   OddsSnapshot.bookmaker — whose *price* odds-api.io quoted
// Do not unify them.
//
// The access code is the login: entering an account's code puts you inside it.
// Only its scrypt hash is stored (src/lib/auth/codes.ts) — a leaked database
// must not hand over the way back in.
model Account {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  codeHash  String
  createdAt DateTime  @default(now())
  bets      Bet[]
  bankroll  Bankroll?
}

model Competition {
  code              String    @id // e.g. "BSA", "PL"
  name              String
  season            Int?
  hasHomeAway       Boolean   @default(true)
  fetchedAt         DateTime?
  fixturesFetchedAt DateTime? // separate TTL from fetchedAt: fixtures refresh independently
  teams             Team[]
  matches           Match[]
  fixtures          Fixture[]
  predictions       Prediction[]
  bets              Bet[]
}

model Team {
  id              Int           @id // football-data.org team id
  name            String
  crestUrl        String?
  competitionCode String
  competition     Competition   @relation(fields: [competitionCode], references: [code])
  standing        TeamStanding?

  @@index([competitionCode])
}

model TeamStanding {
  teamId Int  @id
  team   Team @relation(fields: [teamId], references: [id])

  playedHome       Int
  goalsForHome     Int
  goalsAgainstHome Int

  playedAway       Int
  goalsForAway     Int
  goalsAgainstAway Int

  playedTotal Int
  wonTotal    Int
  drawTotal   Int
  lostTotal   Int
  pointsTotal Int

  fetchedAt DateTime @default(now())
}

// Raw finished-match results, used to compute recency-weighted team stats.
// Immutable once FINISHED, so upserts are idempotent; only grows during a season.
model Match {
  id              Int         @id // football-data.org match id
  competitionCode String
  competition     Competition @relation(fields: [competitionCode], references: [code])
  utcDate         DateTime
  homeTeamId      Int
  awayTeamId      Int
  homeGoals       Int
  awayGoals       Int
  winner          String? // "HOME_TEAM" | "AWAY_TEAM" | "DRAW" | null
  fetchedAt       DateTime    @default(now())

  @@index([competitionCode])
  @@index([competitionCode, utcDate])
}

// Upcoming scheduled matches, purely presentational (feeds team pickers only).
// Denormalized team name/crest and no FK to Team: refreshed independently of
// the standings/match cache, on its own TTL (Competition.fixturesFetchedAt).
model Fixture {
  id              Int         @id // football-data.org match id
  competitionCode String
  competition     Competition @relation(fields: [competitionCode], references: [code])
  utcDate         DateTime
  matchday        Int?
  homeTeamId      Int
  homeTeamName    String
  homeTeamCrest   String?
  awayTeamId      Int
  awayTeamName    String
  awayTeamCrest   String?
  fetchedAt       DateTime    @default(now())

  @@index([competitionCode, utcDate])
}

// A prediction the user explicitly chose to track (see src/lib/predictions/gate.ts —
// only favorite probability >= 65% with alta/media confidence qualifies for saving).
// Evaluated opportunistically whenever refreshFromApi() re-fetches finished matches
// for this competition (standingsCache.ts) — no dedicated polling, no extra API calls.
model Prediction {
  id                  Int         @id @default(autoincrement())
  competitionCode     String
  competition         Competition @relation(fields: [competitionCode], references: [code])
  homeTeamId          Int
  homeTeamName        String
  awayTeamId          Int
  awayTeamName        String
  createdAt           DateTime    @default(now())

  lambdaHome          Float
  lambdaAway          Float
  favorite            String // "home" | "draw" | "away"
  favoriteProbability Float
  bttsYesProbability  Float
  over25Probability   Float
  predictedHomeGoals  Int
  predictedAwayGoals  Int
  confidenceLevel     String // "alta" | "media"

  evaluatedAt         DateTime?
  actualHomeGoals     Int?
  actualAwayGoals     Int?
  correctOneXTwo      Boolean?
  correctBtts         Boolean?
  correctOverUnder25  Boolean?
  correctExactScore   Boolean?
  goalError           Float?

  @@index([competitionCode])
  @@index([evaluatedAt])
}

// A real bet the user placed against their own bookmaker's odds — distinct from
// Prediction, which tracks whether the *model* is accurate. Settled the same
// opportunistic way (see standingsCache.ts:refreshFromApi), matched against the
// Match cache by (homeTeamId, awayTeamId, matchUtcDate) with a tolerance window
// since it targets one specific scheduled fixture rather than "the next match".
model Bet {
  id                  Int          @id @default(autoincrement())

  // Which of the owner's bookmaker accounts this bet was placed with. Every
  // read from the bets page is filtered by it; settlement deliberately is not
  // (see standingsCache.ts:refreshFromApi).
  accountId           Int
  account             Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Where the pick came from. "modelo" for anything sent from the predictor — fixed,
  // since the app knows it produced it — or free text the user types for a manual one
  // (a tipster's name, a hunch, wherever). isManual is what actually branches
  // behaviour: manual bets skip auto-settlement and are closed by hand, because they
  // may be sports or competitions the API does not carry at all.
  source              String       @default("modelo")
  isManual            Boolean      @default(false)

  // Null on manual bets: a tennis match or an unlisted league has no competition,
  // no football-data team ids, and no model probability behind it.
  competitionCode     String?
  competition         Competition? @relation(fields: [competitionCode], references: [code])
  homeTeamId          Int?
  awayTeamId          Int?
  modelProbability    Float?
  suggestedStake      Float? // what fractional-Kelly suggested, kept for reference only

  // Kept required: every bet needs something to name it and a date to file it under,
  // even when it is "Nadal vs Alcaraz" typed by hand.
  homeTeamName        String
  awayTeamName        String
  matchUtcDate        DateTime
  createdAt           DateTime     @default(now())

  market              String // a BetMarket value for model bets, free text for manual ones
  marketLabel         String
  odds                Float // real odds the user entered — not derived from our model
  stake               Float

  status              String    @default("pending") // "pending" | "won" | "lost" | "void" (postponed/cancelled — profit fixed at 0, excluded from staked/yield/win-rate)
  settledAt           DateTime?
  actualHomeGoals     Int?
  actualAwayGoals     Int?
  profit              Float?

  @@index([accountId, createdAt])
  @@index([accountId, status])
  // Kept unprefixed: settlement queries by competition *across* every account.
  @@index([competitionCode])
}


// Real bookmaker prices from odds-api.io, cached so the free plan's 500 requests a
// day are never the limiting factor. One row per (fixture, bookmaker); the whole
// market set is stored as JSON because it is only ever read back as a unit and the
// set of markets differs by bookmaker.
//
// Filled a whole matchday at a time via /odds/multi (10 fixtures per request), so a
// full round costs one request rather than ten. Rows are refreshed on a TTL rather
// than deleted — a stale price is still useful context, and the UI shows its age.
model OddsSnapshot {
  eventId         String // odds-api.io event id
  bookmaker       String
  competitionCode String
  homeTeamName    String // as odds-api.io spells it, kept for debugging the fuzzy match
  awayTeamName    String
  matchUtcDate    DateTime
  marketsJson     String // { "home": 1.55, "btts_yes": 1.95, ... } keyed by BetMarket
  fetchedAt       DateTime @default(now())

  @@id([eventId, bookmaker])
  @@index([competitionCode, matchUtcDate])
}

// One row per request sent to odds-api.io, kept so the hourly and daily caps survive
// a server restart. An in-memory counter would reset to zero every time the dev
// server reloads and happily blow through a 500/day limit it believes is untouched.
// Rows older than the daily window are pruned on write, so this stays tiny.
model OddsApiCall {
  id        Int      @id @default(autoincrement())
  calledAt  DateTime @default(now())
  endpoint  String

  @@index([calledAt])
}

// Sibling of OddsApiCall for the football-data.org budget: one row per request,
// pruned past the 60-second window on write. This lived in a module variable while
// the app ran as one local process; several serverless instances each keeping their
// own count turned a 10/min cap into 10/min *each*.
model FootballDataCall {
  id       Int      @id @default(autoincrement())
  calledAt DateTime @default(now())

  @@index([calledAt])
}

// One row per Account, holding that bookmaker's self-reported starting balance.
// currentBalance is never stored — it's startingBalance + sum(profit) of that
// account's settled Bets.
//
// accountId is the primary key rather than a plain FK beside a surrogate id, so
// "one bankroll per account" is a database guarantee. This model used to be a
// singleton row pinned at id=1 for the same reason, one level down.
model Bankroll {
  accountId       Int      @id
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  startingBalance Float
  updatedAt       DateTime @updatedAt
}
