# Neon Postgres. DATABASE_URL is the *pooled* connection (host contains "-pooler")
# and is what the app queries with; DIRECT_URL is the unpooled one, used only by
# `prisma migrate`, which takes advisory locks that PgBouncer breaks.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Signs the login cookie. Changing it logs every account out — that is the way to
# revoke a session. Use a *different* value in production than locally.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# Timezone for dates rendered on the server (the deployed server runs in UTC).
APP_TIME_ZONE="America/Bogota"

# football-data.org API (server-side only, never exposed to the browser)
# Get a free key at https://www.football-data.org/client/register
# Free plan: 10 requests/minute.
FOOTBALL_DATA_API_KEY=""
FOOTBALL_DATA_BASE_URL="https://api.football-data.org/v4"

# odds-api.io — real bookmaker prices (optional).
# Without it the app still works; the odds column is just typed in by hand.
# Get a free key at https://odds-api.io — free plan: 100 requests/hour, 500/day.
# Pick your bookmakers in their dashboard: the app requests exactly the ones
# selected there, because naming an unavailable one voids the whole response.
ODDS_API_KEY=""
ODDS_API_BASE_URL="https://api.odds-api.io/v3"
